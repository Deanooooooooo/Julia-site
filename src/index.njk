{%- set c = texts.contacts -%}
{%- set tel = c.phone | tel -%}
<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Джулия Тодорова | Клиничен психолог и психотерапевт в София</title>
    <meta
      name="description"
      content="Джулия Тодорова е клиничен психолог и психотерапевт в София. Психоаналитична психотерапия и консултации на място или онлайн при тревожност, кризи и лични трудности."
    />
    <meta
      name="keywords"
      content="клиничен психолог София, психотерапевт София, психолог бул. Витоша, психоаналитична психотерапия София, психолог тревожност София, Джулия Тодорова"
    />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#e9deca" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="canonical" href="{{ site.url }}/" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content="Джулия Тодорова" />
    <meta property="og:url" content="{{ site.url }}/" />
    <meta property="og:title" content="Джулия Тодорова | Клиничен психолог и психотерапевт в София" />
    <meta
      property="og:description"
      content="Психоаналитична психотерапия и психологически консултации в София, на място или онлайн."
    />
    <meta property="og:image" content="{{ site.url }}/assets/julia-todorova-portrait.jpg" />
    <meta property="og:image:alt" content="Джулия Тодорова, клиничен психолог и психотерапевт в София" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Джулия Тодорова | Клиничен психолог и психотерапевт в София" />
    <meta
      name="twitter:description"
      content="Психоаналитична психотерапия и психологически консултации в София, на място или онлайн."
    />
    <meta name="twitter:image" content="{{ site.url }}/assets/julia-todorova-portrait.jpg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="assets/julia-todorova-portrait.jpg" />
    <link rel="stylesheet" href="styles.css?v={{ site.cssVersion }}" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "MedicalBusiness",
        "@id": "https://www.juliatodorova.bg/#business",
        "name": "Джулия Тодорова - клиничен психолог и психотерапевт",
        "url": "https://www.juliatodorova.bg/",
        "description": "Психоаналитична психотерапия и индивидуални психологически консултации в София, на място или онлайн.",
        "image": "https://www.juliatodorova.bg/assets/julia-todorova-portrait.jpg",
        "telephone": {{ tel | dump | safe }},
        "email": {{ c.email | dump | safe }},
        "priceRange": {{ c.price | dump | safe }},
        "currenciesAccepted": "EUR, BGN",
        "medicalSpecialty": "Psychology",
        "areaServed": {
          "@type": "City",
          "name": "София"
        },
        "knowsAbout": [
          "психоаналитична психотерапия",
          "психологически консултации",
          "тревожност",
          "паник атаки",
          "професионално прегаряне",
          "депресия",
          "скръб и загуба",
          "житейска криза",
          "трудности във взаимоотношенията"
        ],
        "offers": {
          "@type": "Offer",
          "name": "Психологическа консултация",
          "price": {{ c.price | priceNumber | dump | safe }},
          "priceCurrency": "EUR",
          "description": "Психологическа консултация в София или онлайн"
        },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ c.address | plainAddress | dump | safe }},
          "addressLocality": "София",
          "addressCountry": "BG"
        },
        "hasMap": "https://www.google.com/search?kgmid=/g/11z80z098q&hl=bg&q=%D0%94%D0%B6%D1%83%D0%BB%D0%B8%D1%8F+%D0%A2%D0%BE%D0%B4%D0%BE%D1%80%D0%BE%D0%B2%D0%B0+-+%D0%BA%D0%BB%D0%B8%D0%BD%D0%B8%D1%87%D0%B5%D0%BD+%D0%BF%D1%81%D0%B8%D1%85%D0%BE%D0%BB%D0%BE%D0%B3+%D0%B8+%D0%BF%D1%81%D0%B8%D1%85%D0%BE%D1%82%D0%B5%D1%80%D0%B0%D0%BF%D0%B5%D0%B2%D1%82",
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": {{ tel | dump | safe }},
          "email": {{ c.email | dump | safe }},
          "contactType": "appointments",
          "areaServed": "BG",
          "availableLanguage": ["Bulgarian"]
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": {{ c.hours | hoursPart(0) | dump | safe }},
            "closes": {{ c.hours | hoursPart(1) | dump | safe }}
          }
        ],
        "sameAs": [
          "https://www.google.com/search?kgmid=/g/11z80z098q&hl=bg&q=%D0%94%D0%B6%D1%83%D0%BB%D0%B8%D1%8F+%D0%A2%D0%BE%D0%B4%D0%BE%D1%80%D0%BE%D0%B2%D0%B0+-+%D0%BA%D0%BB%D0%B8%D0%BD%D0%B8%D1%87%D0%B5%D0%BD+%D0%BF%D1%81%D0%B8%D1%85%D0%BE%D0%BB%D0%BE%D0%B3+%D0%B8+%D0%BF%D1%81%D0%B8%D1%85%D0%BE%D1%82%D0%B5%D1%80%D0%B0%D0%BF%D0%B5%D0%B2%D1%82",
          "https://superdoc.bg/lekar/dzhulia-todorova",
          "https://www.linkedin.com/in/julia-todorova-a5bbb656"
        ]
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Към съдържанието</a>

{% include "header.njk" %}

    <main id="main">
      <section id="top" class="hero section-shell">
        <div class="hero-copy">
          <h1>{{ texts.hero.title }}</h1>
          <div class="hero-text">
{%- for para in texts.hero.paragraphs %}
            <p>{{ para }}</p>
{%- endfor %}
          </div>

          <div class="hero-actions">
            <a class="btn" href="tel:{{ tel }}">Заявете консултация</a>
            <a class="btn btn-ghost" href="#kontakti">Вижте адреса</a>
          </div>

        </div>

        <div class="hero-media" aria-label="Портрет на Джулия Тодорова">
          <img
            src="assets/julia-todorova-portrait.jpg"
            alt="Джулия Тодорова психолог и психотерапевт София"
            width="760"
            height="920"
          />
        </div>

        <dl class="quick-info" aria-label="Кратка информация">
          <div>
            <dt>Адрес</dt>
            <dd>София, {{ c.address }}</dd>
          </div>
          <div>
            <dt>Работно време</dt>
            <dd>{{ c.hours }}</dd>
          </div>
        </dl>

        <ul class="hero-points" aria-label="Акценти">
{%- for point in texts.hero.points %}
          <li>{{ point }}</li>
{%- endfor %}
        </ul>
      </section>

      <section id="za-men" class="section-shell about-section">
        <div class="about-card">
          <div class="about-copy">
            <h2>{{ texts.about.title }}</h2>
            <p>
              {{ texts.about.text }}
            </p>
          </div>

          <div class="about-details">
            <div class="about-block">
              <h3>{{ texts.about.experience_title }}</h3>
              <ul class="check-list">
{%- for item in texts.about.experience %}
                <li>{{ item | inlineMd | safe }}</li>
{%- endfor %}
              </ul>
            </div>

            <div class="about-block">
              <h3>{{ texts.about.memberships_title }}</h3>
              <ul class="check-list">
{%- for item in texts.about.memberships %}
                <li>{{ item | inlineMd | safe }}</li>
{%- endfor %}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section id="pomosht" class="section-shell support-section">
        <div class="section-heading centered">
          <h2>{{ texts.help.title }}</h2>
          <p>
            {{ texts.help.text }}
          </p>
        </div>

        <ul class="support-map" aria-label="Теми за психологическа консултация">
{%- for topic in texts.help.topics %}
          <li>{{ topic }}</li>
{%- endfor %}
        </ul>
      </section>

      <section id="podhod" class="approach-section">
        <div class="section-shell approach-card">
          <div class="approach-heading">
            <h2>{{ texts.approach.title }}</h2>
            <div class="approach-quote">
              <blockquote>
                {{ texts.approach.quote }}
              </blockquote>
            </div>
          </div>

          <div class="approach-copy">
{%- for para in texts.approach.paragraphs %}
            <p>
              {{ para }}
            </p>
{%- endfor %}
          </div>
        </div>
      </section>

      <section class="section-shell testimonials-section" aria-label="Обратна връзка след терапевтични срещи">
        <div class="section-heading centered">
          <h2>{{ texts.testimonials.title }}</h2>
        </div>

        <div class="testimonial-grid">
{%- for t in texts.testimonials.items %}
          <article class="testimonial-card">
            <p>{{ t.text }}</p>
            <strong>{{ t.name }}</strong>
          </article>
{%- endfor %}
        </div>
      </section>

      <section id="kontakti" class="section-shell contact-section">
        <div class="contact-card">
          <div>
            <p class="eyebrow">{{ c.eyebrow }}</p>
            <h2>{{ c.title }}</h2>
            <p>
              {{ c.text }}
            </p>

            <div class="contact-actions">
              <a class="btn" href="tel:{{ tel }}">{{ c.phone }}</a>
            </div>

            <div class="contact-details">
              <p><strong>Адрес:</strong> гр. София, {{ c.address }}</p>
              <p><strong>Работно време:</strong> {{ c.hours }}</p>
              <p><strong>Такса за консултация:</strong> {{ c.price }}</p>
            </div>

            <div class="external-links">
              <a href="https://www.google.com/search?kgmid=/g/11z80z098q&amp;hl=bg&amp;q=%D0%94%D0%B6%D1%83%D0%BB%D0%B8%D1%8F+%D0%A2%D0%BE%D0%B4%D0%BE%D1%80%D0%BE%D0%B2%D0%B0+-+%D0%BA%D0%BB%D0%B8%D0%BD%D0%B8%D1%87%D0%B5%D0%BD+%D0%BF%D1%81%D0%B8%D1%85%D0%BE%D0%BB%D0%BE%D0%B3+%D0%B8+%D0%BF%D1%81%D0%B8%D1%85%D0%BE%D1%82%D0%B5%D1%80%D0%B0%D0%BF%D0%B5%D0%B2%D1%82" target="_blank" rel="noopener">Google профил</a>
              <a href="https://superdoc.bg/lekar/dzhulia-todorova" target="_blank" rel="noopener">Профил в Superdoc</a>
              <a href="https://www.linkedin.com/in/julia-todorova-a5bbb656" target="_blank" rel="noopener">LinkedIn</a>
            </div>
          </div>

          <figure class="cabinet-photo">
            <img
              src="assets/psychology-cabinet-sofia.jpg"
              alt="Психологически кабинет Джулия Тодорова бул. Витоша 61 София"
              width="1200"
              height="857"
            />
          </figure>
        </div>

        <div class="map-wrap" aria-label="Карта до Джулия Тодорова - клиничен психолог и психотерапевт">
          <iframe
            title="Карта до Джулия Тодорова - клиничен психолог и психотерапевт"
            src="https://www.google.com/maps?q=%D0%94%D0%B6%D1%83%D0%BB%D0%B8%D1%8F%20%D0%A2%D0%BE%D0%B4%D0%BE%D1%80%D0%BE%D0%B2%D0%B0%20-%20%D0%BA%D0%BB%D0%B8%D0%BD%D0%B8%D1%87%D0%B5%D0%BD%20%D0%BF%D1%81%D0%B8%D1%85%D0%BE%D0%BB%D0%BE%D0%B3%20%D0%B8%20%D0%BF%D1%81%D0%B8%D1%85%D0%BE%D1%82%D0%B5%D1%80%D0%B0%D0%BF%D0%B5%D0%B2%D1%82%2C%20%D0%B1%D1%83%D0%BB.%20%D0%92%D0%B8%D1%82%D0%BE%D1%88%D0%B0%2061%2C%20%D0%A1%D0%BE%D1%84%D0%B8%D1%8F&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </section>
    </main>

{% include "footer.njk" %}
  </body>
</html>
