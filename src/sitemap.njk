---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{%- set articleDates = [] -%}
{%- for post in collections.articles %}{% set articleDates = (articleDates.push(post.data.date), articleDates) %}{% endfor -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ site.homeLastmod }}</lastmod>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}/blog/</loc>
    <lastmod>{{ (articleDates.concat([site.blogLastmod])) | maxDate }}</lastmod>
    <priority>0.7</priority>
  </url>
{%- for post in collections.articles %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.data.date | isoDate }}</lastmod>
    <priority>0.6</priority>
  </url>
{%- endfor %}
</urlset>
