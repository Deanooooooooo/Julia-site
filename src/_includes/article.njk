{%- set c = texts.contacts -%}
{%- set tel = c.phone | tel -%}
{%- set url = site.url + page.url -%}
{%- set seoTitle = seo_title or title -%}
{%- set metaDescription = seo_description or summary -%}
{%- set socialDescription = social_description or summary -%}
{%- set published = linkedin_date or date -%}
{%- set changed = modified or date -%}
{%- set imageUrl = image if image.startsWith("http") else site.url + image -%}
{%- set featDims = image | imageDims -%}
<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ seoTitle }} | Джулия Тодорова</title>
    <meta
      name="description"
      content="{{ metaDescription }}"
    />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#e9deca" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="canonical" href="{{ url }}" />

    <meta property="og:type" content="article" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content="Джулия Тодорова" />
    <meta property="og:url" content="{{ url }}" />
    <meta property="og:title" content="{{ seoTitle }}" />
    <meta
      property="og:description"
      content="{{ socialDescription }}"
    />
    <meta property="og:image" content="{{ imageUrl }}" />
    <meta property="og:image:alt" content="{{ image_alt }}" />
    <meta property="article:published_time" content="{{ published | isoDate }}" />
    <meta property="article:modified_time" content="{{ changed | isoDate }}" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="../../styles.css?v={{ site.cssVersion }}" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": {{ title | dump | safe }},
        "description": {{ metaDescription | dump | safe }},
        "author": {
          "@type": "Person",
          "name": "Джулия Тодорова",
          "url": "https://www.juliatodorova.bg/"
        },
        "publisher": {
          "@type": "Person",
          "name": "Джулия Тодорова"
        },
        "datePublished": "{{ published | isoDate }}",
        "dateModified": "{{ changed | isoDate }}",
        "mainEntityOfPage": {{ url | dump | safe }},
        "image": {{ imageUrl | dump | safe }}
      }
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Начало",
            "item": "https://www.juliatodorova.bg/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Блог",
            "item": "https://www.juliatodorova.bg/blog/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ (breadcrumb or title) | dump | safe }},
            "item": {{ url | dump | safe }}
          }
        ]
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Към съдържанието</a>

{% include "header.njk" %}

    <main id="main">
      <article class="section-shell article-layout">
        <nav class="breadcrumb" aria-label="Път до страницата">
          <a href="/">Начало</a>
          <span>/</span>
          <a href="/blog/">Блог</a>
        </nav>

        <header class="article-header">
{%- if eyebrow %}
          <p class="eyebrow">{{ eyebrow }}</p>
{%- endif %}
          <h1>{{ title }}</h1>
          <div class="article-byline">
            <img
              src="../../assets/julia-todorova-razkazhimi.jpg"
              alt="Джулия Тодорова"
              width="800"
              height="1200"
            />
            <div>
              <p>Джулия Тодорова</p>
{%- if linkedin_date %}
              <span>Публикувано в LinkedIn: {{ linkedin_date | bgDate }}</span>
{%- endif %}
              <span>Публикувано в сайта: {{ date | bgDate }}</span>
            </div>
          </div>

          <figure class="article-featured">
            <img
              src="{{ image }}"
              alt="{{ image_alt }}"
{%- if featDims %}
              width="{{ featDims.width }}"
              height="{{ featDims.height }}"
{%- endif %}
            />
{%- if image_caption %}
            <figcaption>
              {{ image_caption | inlineMd | safe }}
            </figcaption>
{%- endif %}
          </figure>
        </header>

        <div class="article-body">
          {{ content | articleBody({ linkedin_date: linkedin_date }) | safe }}
        </div>

        <footer class="article-author">
          <img
            src="../../assets/julia-todorova-razkazhimi.jpg"
            alt="Джулия Тодорова психолог и психотерапевт София"
            width="360"
            height="360"
          />
          <div>
            <h2>Джулия Тодорова</h2>
            <p>
              Клиничен психолог и психотерапевт. Работи с възрастни, юноши и родители,
              които срещат трудности в грижата за децата си.
            </p>
            <a class="btn" href="tel:{{ tel }}">Запитване за консултация</a>
          </div>
        </footer>
      </article>
    </main>

{% include "footer.njk" %}
  </body>
</html>
