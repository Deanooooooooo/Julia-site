{%- set c = texts.contacts -%}
{%- set tel = c.phone | tel -%}
    <footer class="site-footer">
      <div>
        <strong>Джулия Тодорова</strong>
        <span>Психолог и психотерапевт, София</span>
      </div>

      <nav class="footer-social" aria-label="Профили на Джулия Тодорова">
        <a href="https://www.linkedin.com/in/julia-todorova-a5bbb656" target="_blank" rel="noopener" aria-label="LinkedIn профил на Джулия Тодорова">
{%- if isHome %}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6.94 8.96H3.72v10.36h3.22V8.96ZM5.34 7.54a1.86 1.86 0 1 0 0-3.72 1.86 1.86 0 0 0 0 3.72Zm13.3 6.1c0-3.12-1.67-4.57-3.9-4.57-1.8 0-2.6.99-3.05 1.68V8.96H8.61v10.36h3.21v-5.13c0-1.35.26-2.66 1.93-2.66 1.64 0 1.66 1.54 1.66 2.75v5.04h3.22v-5.68Z" />
          </svg>
{%- endif %}
          <span>LinkedIn</span>
        </a>
        <a href="https://superdoc.bg/lekar/dzhulia-todorova" target="_blank" rel="noopener" aria-label="Superdoc профил на Джулия Тодорова">
{%- if isHome %}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 3.2c-4.86 0-8.8 3.94-8.8 8.8s3.94 8.8 8.8 8.8 8.8-3.94 8.8-8.8S16.86 3.2 12 3.2Zm0 3.15a2.53 2.53 0 1 1 0 5.06 2.53 2.53 0 0 1 0-5.06Zm4.68 10.38a6.67 6.67 0 0 1-9.36 0c.36-1.92 2.18-3.22 4.68-3.22s4.32 1.3 4.68 3.22Z" />
          </svg>
{%- endif %}
          <span>Superdoc</span>
        </a>
      </nav>

      <div class="footer-contact">
{%- if isHome %}
        <a href="tel:{{ tel }}" aria-label="Телефон {{ c.phone }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.15 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1C10.61 21 3 13.39 3 4c0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.24.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2Z" />
          </svg>
          <span>{{ c.phone }}</span>
        </a>
        <a href="mailto:{{ c.email }}" aria-label="Имейл {{ c.email }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z" />
          </svg>
          <span>{{ c.email }}</span>
        </a>
{%- else %}
        <a href="tel:{{ tel }}" aria-label="Телефон {{ c.phone }}"><span>{{ c.phone }}</span></a>
        <a href="mailto:{{ c.email }}" aria-label="Имейл {{ c.email }}"><span>{{ c.email }}</span></a>
{%- endif %}
      </div>

      <p class="footer-credit">Сайт и поддръжка: <a href="https://raboti.bg/sluzhiteli/pishe/">Raboti</a></p>
    </footer>

    <a class="mobile-call" href="tel:{{ tel }}" aria-label="Запитване за консултация">Запитване за консултация</a>
