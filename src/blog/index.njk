---
permalink: /blog/index.html
---
{%- set first = collections.articles[0] -%}
<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Блог | Джулия Тодорова</title>
    <meta
      name="description"
      content="Текстове на Джулия Тодорова за човешките ни противоречия, връзките, които ни оформят, и отношението ни към самите нас."
    />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#e9deca" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="canonical" href="{{ site.url }}/blog/" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content="Джулия Тодорова" />
    <meta property="og:url" content="{{ site.url }}/blog/" />
    <meta property="og:title" content="Блог | Джулия Тодорова" />
    <meta
      property="og:description"
      content="Текстове на Джулия Тодорова за човешките ни противоречия, връзките, които ни оформят, и отношението ни към самите нас."
    />
{%- if first %}
    <meta property="og:image" content="{{ first.data.image if first.data.image.startsWith('http') else site.url + first.data.image }}" />
    <meta property="og:image:alt" content="{{ first.data.image_alt }}" />
{%- endif %}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="../styles.css?v={{ site.cssVersion }}" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "@id": "https://www.juliatodorova.bg/blog/#webpage",
        "url": "https://www.juliatodorova.bg/blog/",
        "name": "Блог | Джулия Тодорова",
        "description": "Текстове на Джулия Тодорова за човешките ни противоречия, връзките, които ни оформят, и отношението ни към самите нас.",
        "isPartOf": {
          "@type": "WebSite",
          "name": "Джулия Тодорова",
          "url": "https://www.juliatodorova.bg/"
        }
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Към съдържанието</a>

{% include "header.njk" %}

    <main id="main">
      <section class="section-shell blog-hero">
        <p class="eyebrow">Блог</p>
        <h1>Статии за човешките ни противоречия, за връзките, които ни оформят, и за отношението ни към самите нас.</h1>
        <p>
          Текстове на Джулия Тодорова
        </p>
      </section>

      <section class="section-shell blog-list-section" aria-label="Последни статии">
        <div class="section-heading">
          <h2>Последни статии</h2>
        </div>
{% for post in collections.articles %}
{%- set d = post.data -%}
{%- set dims = d.image | imageDims %}
        <article class="article-card">
          <a class="article-card-image" href="{{ post.url }}" aria-label="{{ d.title }}">
            <img
              src="{{ d.image }}"
              alt="{{ d.image_alt }}"
{%- if dims %}
              width="{{ dims.width }}"
              height="{{ dims.height }}"
{%- endif %}
              loading="lazy"
            />
          </a>
          <div class="article-card-copy">
            <div class="article-card-byline">
              <img
                src="../assets/julia-todorova-razkazhimi.jpg"
                alt="Джулия Тодорова"
                width="800"
                height="1200"
                loading="lazy"
              />
              <div>
                <p>Джулия Тодорова</p>
{%- if d.linkedin_date %}
                <span>LinkedIn: {{ d.linkedin_date | bgDate }}</span>
{%- endif %}
                <span>Сайт: {{ d.date | bgDate }}</span>
              </div>
            </div>
            <h3>
              <a href="{{ post.url }}">
                {{ d.title }}
              </a>
            </h3>
            <p>
              {{ d.summary }}
            </p>
            <a class="text-link" href="{{ post.url }}">Прочетете статията</a>
          </div>
        </article>
{% endfor %}
      </section>
    </main>

{% include "footer.njk" %}
  </body>
</html>
